{
  "name": "cupbox",
  "version": "1.2.0",
  "description": "把杂活交给 AI —— CLI + MCP + Electron 桌面版三形态的本地工具箱：桌面工具箱 121 项、原生工作引擎 66 项、CLI/MCP 21 项，覆盖文件与办公处理、OCR/图片、Agent 与三层记忆、多平台 QQ 机器人",
  "keywords": [
    "mcp",
    "cli",
    "toolbox",
    "file-organizer",
    "batch-rename",
    "ocr",
    "clipboard",
    "developer-tools",
    "ai-agent",
    "claude",
    "cursor",
    "image-obfuscation",
    "pixel-scramble",
    "electron",
    "desktop-app"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "bin": {
    "cupbox": "dist/index.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./mcp": "./dist/mcp.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsc -p tsconfig.build.json --watch",
    "desktop": "electron desktop",
    "pack:exe": "node desktop/pack.mjs",
    "pack:installer": "node desktop/installer/build.mjs",
    "mcp": "node dist/mcp.js",
    "prepublishOnly": "npm run build && npm test",
    "preversion": "npm test",
    "version": "node -e \"console.log('version bumped')\"",
    "postversion": "git push && git push --tags"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@meting/core": "1.6.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@modelcontextprotocol/server-filesystem": "^2.0.0",
    "@nut-tree-fork/libnut-win32": "2.7.5",
    "@pdf-lib/fontkit": "1.1.1",
    "@tencent-connect/qqbot-nodejs": "1.0.5",
    "@wecom/aibot-node-sdk": "1.0.7",
    "@xmldom/xmldom": "0.9.12",
    "diff": "^9.0.0",
    "docx": "9.14.0",
    "dompurify": "^3.4.17",
    "echomusic-api": "https://codeload.github.com/MakcRe/KuGouMusicApi/tar.gz/514f870db7e60ca37bc5535be5da36d32b571c6f",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "ffmpeg-static": "5.3.0",
    "iconv-lite": "^0.7.3",
    "ignore": "^7.0.12",
    "ipaddr.js": "^2.5.0",
    "jszip": "3.10.2",
    "lunar-javascript": "^1.7.7",
    "marked": "^15.0.12",
    "minimatch": "^10.2.6",
    "nodemailer": "10.2.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^4.8.69",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "pptxgenjs": "4.0.1",
    "qrcode": "1.5.4",
    "safe-regex2": "^5.1.2",
    "sharp": "^0.35.5",
    "silk-wasm": "3.7.1",
    "string-argv": "^0.4.0",
    "ws": "8.21.0",
    "yauzl": "3.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "electron": "^44.9.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/beizilaoshi/cupbox.git"
  },
  "homepage": "https://github.com/beizilaoshi/cupbox#readme",
  "bugs": {
    "url": "https://github.com/beizilaoshi/cupbox/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
